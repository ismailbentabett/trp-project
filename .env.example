# Copy to .env and fill in the values. See the Configuration section of README.md.

# Application
APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=
VITE_APP_NAME=
VITE_APP_URL=

# Sail / Docker (optional overrides)
APP_PORT=
VITE_PORT=
FORWARD_DB_PORT=

# Logging
LOG_CHANNEL=
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=

# Database
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Drivers
BROADCAST_DRIVER=
CACHE_DRIVER=
FILESYSTEM_DISK=
FILAMENT_FILESYSTEM_DISK=
QUEUE_CONNECTION=
SESSION_DRIVER=
SESSION_LIFETIME=

# Redis / Memcached
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=
MEMCACHED_HOST=

# Mail
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=

# Cloudinary (media for social publishing)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Uploads and media processing
FILEPOND_TEMP_DISK=
FFMPEG_BINARIES=
FFPROBE_BINARIES=

# Pusher (broadcasting)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=
PUSHER_APP_CLUSTER=
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=
VITE_PUSHER_APP_CLUSTER=

# Search (Laravel Scout + Algolia)
SCOUT_DRIVER=
SCOUT_QUEUE=
ALGOLIA_APP_ID=
ALGOLIA_SECRET=
# VITE_ values are bundled into public JavaScript: use a search-only key here
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SECRET=

# OpenAI (AI content generator)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Meta (Facebook pages and Instagram publishing)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Google sign-in
SOCIAL_AUTH_GOOGLE_KEY=
SOCIAL_AUTH_GOOGLE_SECRET=
SOCIAL_AUTH_GOOGLE_REDIRECT_URI=

# Laravel Telescope
TELESCOPE_ENABLED=
